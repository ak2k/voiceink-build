# Pins for .github/workflows/build.yml. Format: KEY=value, no spaces or quotes.
#
# VOICEINK_REV must contain the commit VOICEINK_TAG points to; the build checks
# this. For v2.21 it is upstream's merge of the tag commit (640b0c8c) with its
# "Bump version to 2.21" commit. The tag commit itself still says 2.20 in
# project.pbxproj, while the official v2.21 app says 2.21 (build 221).
VOICEINK_TAG=v2.21
VOICEINK_REV=6fdf011c991f3517023c7883ddc4ee37c6de6109

# Upstream's Makefile clones whisper.cpp HEAD; this build pins a release instead.
WHISPER_TAG=v1.9.4
WHISPER_REV=927cfce34f31707e17f2bff35c349632fb9e2c3a

# Upstream built the official v2.21 app with Xcode 27.0 (27A266a).
XCODE_VERSION=27.0
XCODE_BUILD=27A266a
