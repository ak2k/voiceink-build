diff --git a/VoiceInk/Infrastructure/Providers/Transcription/Cloud/Streaming/CustomLivePreviewProvider.swift b/VoiceInk/Infrastructure/Providers/Transcription/Cloud/Streaming/CustomLivePreviewProvider.swift
new file mode 100644
index 0000000..5c542b5
--- /dev/null
+++ b/VoiceInk/Infrastructure/Providers/Transcription/Cloud/Streaming/CustomLivePreviewProvider.swift
@@ -0,0 +1,34 @@
+import Foundation
+import SwiftData
+
+/// Live preview for custom models: xAI's stream fills the recorder's partial text, and stop
+/// requests batch fallback so the pasted text comes from the custom endpoint alone.
+final class CustomLivePreviewProvider: StreamingTranscriptionProvider {
+
+    private let preview: XAIStreamingProvider
+
+    var stopDisposition: StreamingStopDisposition { .useBatchFallback }
+
+    var transcriptionEvents: AsyncStream<StreamingTranscriptionEvent> { preview.transcriptionEvents }
+
+    init(modelContext: ModelContext) {
+        preview = XAIStreamingProvider(modelContext: modelContext)
+    }
+
+    func connect(model: any TranscriptionModel, language: String?) async throws {
+        // LLMkit's xAI stream sends no model name, so the custom model passes through as is.
+        try await preview.connect(model: model, language: language)
+    }
+
+    func sendAudioChunk(_ data: Data) async throws {
+        try await preview.sendAudioChunk(data)
+    }
+
+    func commit() async throws {
+        try await preview.commit()
+    }
+
+    func disconnect() async {
+        await preview.disconnect()
+    }
+}
