# The code-signing certificate held in the VOICEINK_SIGNING_P12 secret.
# Every signed app embeds this certificate, so its hash is public. macOS keeps
# permission grants only while the app's designated requirement names this
# hash, so the build fails if the secret holds any other certificate.
# Format: KEY=value, no spaces or quotes. SHA-1 of the DER certificate,
# uppercase hex, no colons.
VOICEINK_CERT_SHA1=528AC9B2C6A87219146B0A001E246C5340905453
